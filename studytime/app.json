{
  "expo": {
    "name": "studytime",
    "slug": "StudyTime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "studytime",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/StudyTime-splash.png",
      "bundleIdentifier": "com.anonymous.studytime"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/StudyTime-splash.png",
        "backgroundColor": "#7C3AED"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.studytime"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/StudyTime-splash.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7C3AED",
          "image": "./assets/StudyTime-splash.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
