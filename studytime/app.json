{
  "expo": {
    "name": "StudyTime",
    "slug": "StudyTime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "studytime",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/StudyTime-splash.png",
      "bundleIdentifier": "com.anonymous.studytime"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#7C3AED"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.studytime",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/StudyTime-splash.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7C3AED",
          "image": "./assets/StudyTime-splash.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "O StudyTime acessa suas fotos para anexar às atividades.",
          "cameraPermission": "O StudyTime usa a câmera para fotografar suas atividades."
        }
      ],
      ["expo-calendar", { "calendarPermission": "O StudyTime adiciona suas entregas à agenda." }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
